<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KinoshitaProductions.BooruNav.ViewModels"
             xmlns:controls="using:KinoshitaProductions.BooruNav.Controls"
             x:Class="KinoshitaProductions.BooruNav.Views.ShellView"
             x:DataType="vm:ShellViewModel">
    <!-- No Design.DataContext: ShellViewModel has DI-only constructor deps; x:DataType drives bindings. -->
    <Panel>
        <!-- Shared backdrop gradient; persists across splash → welcome → main transitions. -->
        <Rectangle Margin="0,86,0,0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#FF141212"/>
                    <GradientStop Offset="1" Color="#FF8C1E59"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        
        <!--
        <controls:BorealBackground Accent="#ff2d9c" TopSpacing="0.4">
            <controls:BorealBackground.Background>
             
            </controls:BorealBackground.Background>
        </controls:BorealBackground>
        -->
        <TransitioningContentControl Content="{Binding Current}"/>
    </Panel>
</UserControl>
