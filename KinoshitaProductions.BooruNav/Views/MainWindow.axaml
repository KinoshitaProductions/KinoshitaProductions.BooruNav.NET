<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KinoshitaProductions.BooruNav.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:KinoshitaProductions.BooruNav.Views"
        xmlns:controls="using:KinoshitaProductions.BooruNav.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="KinoshitaProductions.BooruNav.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="KinoshitaProductions.BooruNav">
        <!-- Mode="Desktop" fills the window; switch to "Mobile" to letterbox into a phone viewport.
             These attributes only seed the initial state — IViewportService is the source of truth. -->
        <controls:ViewportHost Mode="Mobile" Aspect="20:9">
            <views:MainView />
        </controls:ViewportHost>
</Window>
