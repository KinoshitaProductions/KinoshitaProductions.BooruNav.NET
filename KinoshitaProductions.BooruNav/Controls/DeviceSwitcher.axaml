<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KinoshitaProductions.BooruNav.ViewModels"
             xmlns:presentation="using:KinoshitaProductions.BooruNav.Presentation"
             xmlns:controls="using:KinoshitaProductions.BooruNav.Controls"
             xmlns:styling="using:Avalonia.Styling"
             x:Class="KinoshitaProductions.BooruNav.Controls.DeviceSwitcher"
             x:DataType="vm:DeviceSwitcherViewModel">
    <UserControl.Resources>
        <controls:ThemeVariantToBoolConverter x:Key="ThemeToBool"/>
    </UserControl.Resources>

    <Border Background="#CC1E1E1E"
            CornerRadius="8"
            Padding="10"
            BoxShadow="0 2 12 0 #80000000">
        <StackPanel Spacing="6" MinWidth="200">
            <TextBlock Text="Device preview" FontWeight="SemiBold" FontSize="12" Opacity="0.85"/>

            <ComboBox ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="presentation:DevicePreset">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ToggleButton Content="Landscape"
                          IsChecked="{Binding IsLandscape}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"/>

            <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.7"/>

            <Separator Margin="0,2"/>

            <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="12" Opacity="0.85"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton GroupName="Theme" Content="System"
                             IsChecked="{Binding SelectedTheme, Mode=TwoWay,
                                         Converter={StaticResource ThemeToBool},
                                         ConverterParameter={x:Static styling:ThemeVariant.Default}}"/>
                <RadioButton GroupName="Theme" Content="Light"
                             IsChecked="{Binding SelectedTheme, Mode=TwoWay,
                                         Converter={StaticResource ThemeToBool},
                                         ConverterParameter={x:Static styling:ThemeVariant.Light}}"/>
                <RadioButton GroupName="Theme" Content="Dark"
                             IsChecked="{Binding SelectedTheme, Mode=TwoWay,
                                         Converter={StaticResource ThemeToBool},
                                         ConverterParameter={x:Static styling:ThemeVariant.Dark}}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
