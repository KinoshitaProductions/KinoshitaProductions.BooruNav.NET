<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KinoshitaProductions.BooruNav.Controls"
        xmlns:i18n="using:KinoshitaProductions.BooruNav.Localization">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- #141313 fading 100% → ~90% alpha, left to right across the bar. -->
                    <LinearGradientBrush x:Key="TitleBarBackground" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#FF141313"/>
                        <GradientStop Offset="1" Color="#E6141313"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="TitleForeground" Color="White"></SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="TitleBarBackground" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#FF141313"/>
                        <GradientStop Offset="1" Color="#E6141313"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="TitleForeground" Color="White"></SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    
    <Style Selector="controls|TitleBar" >
        <Setter Property="Background" Value="{DynamicResource TitleBarBackground}"/>
        <Setter Property="Height" Value="86"/>
        <Setter Property="Template">
            <ControlTemplate>
                <!--
                <Border BorderThickness="0,0,0,3" BorderBrush="#bbff2d9c">
                -->
                <Grid ColumnDefinitions="*,Auto" Background="{TemplateBinding Background}">
                    <!-- Draggable region. Transparent (not null) so it stays hit-testable. -->
                    <Panel Grid.Column="0" Name="PART_DragArea" Background="Transparent" Margin="16,32,0,0">
                        <TextBlock Text="{i18n:Translate Welcome_Title}"
                                   Foreground="{DynamicResource TitleForeground}"
                                   VerticalAlignment="Top" Margin="12,0" FontSize="24"/>
                    </Panel>

                    <!-- Host-injected widget (e.g. LanguageSelector) — self-contained, brings its own label. -->
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding RightContent}" Margin="0,32,16,0"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Caption button look: flat, square, transparent until hovered. -->
    <Style Selector="controls|TitleBar Button.caption">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="controls|TitleBar Button.caption /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="controls|TitleBar Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>
    <Style Selector="controls|TitleBar Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E81123"/>
    </Style>
</Styles>
